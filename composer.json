{
    "name": "coolms/field-doctrine",
    "description": "Doctrine ORM adapters for coolms/field: the XML mapping for the field definition, its repository, and the entity field-name resolver the schema tooling reads",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "coolms",
        "field",
        "doctrine",
        "orm",
        "mapping"
    ],
    "authors": [
        {
            "name": "Dmitry Popov"
        }
    ],
    "require": {
        "php": "^8.5",
        "coolms/core": "^2.0",
        "coolms/entity": "^2.0",
        "coolms/field": "^2.0",
        "doctrine/orm": "^3.0",
        "doctrine/persistence": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "CoolMS\\Field\\Doctrine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoolMS\\Field\\Doctrine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-develop": "2.0.x-dev"
        }
    }
}
